{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-dice-engine.local/schemas/table-protocol-v1.schema.json",
  "title": "TTRPG table protocol v1 envelopes",
  "description": "Metadata definitions, enforced by table-commands.ts at the REST boundary. Route payload validation is documented separately. Party Mode will define its own round/stage payloads.",
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["schemaVersion", "sessionId", "mode", "actorId", "roundId", "stage"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "mode": { "const": "ttrpg" },
        "actorId": { "type": "string", "minLength": 1 },
        "roundId": { "type": "null" },
        "stage": { "const": "table" },
        "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "command": {
      "type": "object",
      "required": ["requestId", "_command"],
      "properties": {
        "requestId": { "$ref": "#/$defs/requestId" },
        "_command": { "$ref": "#/$defs/metadata" }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["schemaVersion", "sessionId", "mode", "roundId", "stage", "revision"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "mode": { "const": "ttrpg" },
        "roundId": { "type": "null" },
        "stage": { "const": "table" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "required": ["schemaVersion", "type", "sessionId", "mode", "actorId", "kind", "requestId", "roundId", "stage", "revision", "committedAt"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "type": { "const": "command_committed" },
        "sessionId": { "type": "string", "minLength": 1 },
        "mode": { "const": "ttrpg" },
        "actorId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "roundId": { "type": "null" },
        "stage": { "const": "table" },
        "revision": { "type": "integer", "minimum": 1 },
        "committedAt": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/event" }
  ]
}
