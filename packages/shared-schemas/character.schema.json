{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-dice-engine.local/schemas/character.schema.json",
  "title": "Character",
  "type": "object",
  "required": ["id", "campaignId", "name", "role", "visibility", "stats"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "campaignId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": ["gm_only", "player_visible", "public_demo"]
    },
    "pronouns": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "string", "boolean"]
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "current", "max"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "current": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "quantity"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visualIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artStyle": {
          "type": "string"
        },
        "visualCanon": {
          "type": "string",
          "description": "Compact description of the character's locked visual identity."
        },
        "prompt": {
          "type": "string"
        },
        "negativePrompt": {
          "type": "string"
        },
        "acceptedReferenceAssetIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "turnaroundAssetIds": {
          "type": "object",
          "description": "Map of view names such as front, threeQuarter, profile, back, combatPose, or expressionSheet to asset ids.",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "rejectedAssetIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "generationNotes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    }
  }
}
