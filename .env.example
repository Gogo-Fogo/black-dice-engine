# Black Dice Engine local configuration example.
# Copy to a private .env only if needed; never commit real credentials or paths.
# All Node services consume process environment and never search for .env files.
# Build from the repository root, then explicitly load a chosen env file:
# node --env-file=.env services/game-server/dist/index.js
# node --env-file=.env services/audio-service/dist/index.js
# node --env-file=.env services/comfy-router/dist/index.js
# node --env-file=.env services/runtime-service/dist/index.js
# For tsx development use inherited environment or Node's explicit --env-file;
# npm dev shortcuts do not load .env automatically.

BDE_ENV=development
BDE_HOST=127.0.0.1
BDE_GAME_SERVER_PORT=4310
BDE_AUDIO_SERVICE_PORT=4321
BDE_COMFY_ROUTER_PORT=4320
BDE_RUNTIME_SERVICE_PORT=4322
# Direct server start retains the compatibility full profile.
# start-party.bat forces party, disables optional endpoints/stores and uses separate data.
# BDE_RUNTIME_PROFILE=party
# LAN access is explicit: BDE_HOST=0.0.0.0 (or start-party.bat --lan).

# Paths resolve relative to the repository root, independent of shell cwd and src/dist.
# Defaults remain _data/black-dice-engine.db, _exports and _backups; no data is moved.
# Keep private data/backups outside Git and use explicit absolute paths when appropriate.
# BDE_DB_PATH=C:\your-local-data\session.db
# BDE_EXPORT_ROOT=C:\your-local-data\exports
# Campaign folder (bible, locations, NPCs, optional progress-seed.json). Defaults to the demo sample.
# Keep private or licensed campaigns in ignored _local-context/ and pair them with their own --data-dir.
# BDE_CAMPAIGN_DIR=_local-context/your-campaign/campaign
# BDE_BACKUPS_DIR=C:\your-local-data\backups
# Validated snapshots at process start and graceful end. Set 0 to disable automatic snapshots.
BDE_AUTO_BACKUP=1

# Optional stores/endpoints stay disabled when absent. Party profile ignores these.
# BDE_AUDIO_DIR=C:\your-local-assets\audio
# BDE_MEDIA_OUTPUT_ROOT=C:\your-local-output\generated
# BDE_COMFY_OUTPUT_DIR=C:\your-local-output\bde
# BDE_COMFY_OUTPUT_ROOT=C:\your-local-output
# BDE_COMFY_API_BASE=http://127.0.0.1:8188
# BDE_COMFY_ROUTER_ENDPOINT=http://127.0.0.1:4320
# BDE_TTS_SERVICE_ENDPOINT=http://127.0.0.1:4323
# BDE_AUDIO_SERVICE_ENDPOINT=http://127.0.0.1:4321
# BDE_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434
# Runtime monitor defaults to http://127.0.0.1:4310; override for a custom game port.
# BDE_GAME_SERVER_ENDPOINT=http://127.0.0.1:4310
# Base URLs require HTTP(S) without embedded credentials, query strings or fragments.

# Existing full-profile LLM adapter configuration. Party disables it before any fetch.
# Supported providers: ollama, openai (chatgpt is a compatibility alias).
BDE_LLM_PROVIDER=ollama
# Remote/LAN inference is blocked unless explicitly enabled by the host.
# A provider selection, configured URL or API key alone does not grant consent.
BDE_ALLOW_REMOTE_AI=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Optional local director alongside a hosted main model; loopback Ollama only.
# Unloads after each reply to release GPU memory for images. No cloud fallback.
# BDE_DIRECTOR_MODE_MODEL=qwen3.5:4b
# OPENAI_API_KEY=your-local-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Python TTS is separately launched; explicit files are required, never discovered/downloaded.
# BDE_TTS_SERVICE_PORT=4323
# BDE_TTS_MODEL_PATH=<explicit existing ONNX model path>
# BDE_TTS_VOICES_PATH=<explicit existing voices binary path>
# See services/tts-service/README.md for --check without loading models.
BDE_LOG_LEVEL=info
