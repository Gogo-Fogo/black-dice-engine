# Black Dice Engine local configuration example.
# Copy to .env for local use. Never commit real .env files.

BDE_ENV=development
BDE_HOST=127.0.0.1
BDE_GAME_SERVER_PORT=4310
BDE_PLAYER_COMPANION_PORT=4311

# Local-only data roots. Keep these outside the Git repository.
BDE_MODELS_DIR=G:\AI-DM\02_models
BDE_CAMPAIGNS_DIR=G:\AI-DM\03_campaigns
BDE_ASSETS_DIR=G:\AI-DM\04_assets

# Local model endpoints.
BDE_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
KOBOLDCPP_BASE_URL=http://127.0.0.1:5001

# Local image/video workflow endpoint.
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Development logging.
BDE_LOG_LEVEL=info
