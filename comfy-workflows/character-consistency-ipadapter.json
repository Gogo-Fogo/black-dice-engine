{
  "1": {
    "inputs": { "ckpt_name": "sdxl_lightning_4step.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "inputs": { "text": "{{positivePrompt}}", "clip": ["1", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "inputs": { "text": "{{negativePrompt}}", "clip": ["1", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "inputs": { "image": "{{referenceImageName}}" },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Reference Image" }
  },
  "5": {
    "inputs": { "clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K\\model.safetensors" },
    "class_type": "CLIPVisionLoader",
    "_meta": { "title": "Load CLIP Vision" }
  },
  "6": {
    "inputs": { "ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors" },
    "class_type": "IPAdapterModelLoader",
    "_meta": { "title": "Load IPAdapter" }
  },
  "7": {
    "inputs": {
      "model": ["1", 0],
      "ipadapter": ["6", 0],
      "image": ["4", 0],
      "clip_vision": ["5", 0],
      "weight": 0.85,
      "weight_type": "standard",
      "start_at": 0.0,
      "end_at": 1.0
    },
    "class_type": "IPAdapter",
    "_meta": { "title": "IPAdapter" }
  },
  "8": {
    "inputs": { "width": 832, "height": 1216, "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent Image" }
  },
  "9": {
    "inputs": {
      "seed": {{seed}},
      "steps": 4,
      "cfg": 2.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["7", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["8", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" }
  },
  "10": {
    "inputs": { "samples": ["9", 0], "vae": ["1", 2] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "11": {
    "inputs": { "filename_prefix": "bde/character", "images": ["10", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
